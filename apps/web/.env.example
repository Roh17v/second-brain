# Backend API (direct). With Vite proxy you can also leave this empty and use /api.
VITE_API_BASE_URL=http://localhost:8080

# Google Sign-In (optional). Same OAuth Web client ID as backend GOOGLE_CLIENT_ID.
# Authorized JavaScript origins must include http://localhost:5173
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
