# Copy values into IntelliJ Run Configuration → Environment variables
# (or set as OS env vars). Spring Boot does not auto-load .env files.
#
# PowerShell example:
#   $env:DB_URL="jdbc:postgresql://localhost:5432/secondbrain?user=postgres&password=your_password"
#   $env:JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
#   .\mvnw.cmd spring-boot:run
#
# AI providers are pluggable: change *_PROVIDER (+ model/key) only.
# Chat / search / ingestion code does not import concrete providers.

# Database — one variable only (include user + password in the JDBC URL)
DB_URL=jdbc:postgresql://localhost:5432/secondbrain?user=postgres&password=your_password

# JWT (required) — use a long random string (32+ characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8080

# ---------- Local AI (default) ----------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2

# ---------- Cloud AI examples (VPS / live) — uncomment & set keys ----------
# Never commit real keys.
#
# GEMINI_API_KEY=your-google-ai-studio-key
#
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_OUTPUT_DIMENSIONALITY=768
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
# EMBEDDING_API_KEY=   # defaults to GEMINI_API_KEY if empty
#
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_API_KEY=         # defaults to GEMINI_API_KEY if empty
#
# --- Groq chat (OpenAI-compatible; free tier e.g. Qwen 27B) ---
# GROQ_API_KEY=your-groq-key
# LLM_PROVIDER=groq
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TEMPERATURE=0.6
# LLM_REASONING_EFFORT=none
#
# After switching embedding model/provider/dimensions: re-embed all documents.

# File storage
FILE_STORAGE_PATH=./storage

# Mistral OCR (scanned PDFs + photo notes)
OCR_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key
# OCR_MODEL=mistral-ocr-latest
# OCR_MIN_TEXT_CHARS=40
# OCR_TIMEOUT_SECONDS=180
