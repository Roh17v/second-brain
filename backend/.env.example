# Copy to .env for your own notes if you like, then export as OS env vars.
# Spring Boot reads process environment variables (not .env files by default).
#
# PowerShell example:
#   $env:DB_URL="jdbc:postgresql://localhost:5432/secondbrain"
#   $env:DB_USERNAME="postgres"
#   $env:DB_PASSWORD="your_password"
#   .\mvnw.cmd spring-boot:run

# Database
DB_URL=jdbc:postgresql://localhost:5432/secondbrain
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Server
SERVER_PORT=8080

# Future (not required yet)
JWT_SECRET=replace_me
OLLAMA_BASE_URL=http://localhost:11434
FILE_STORAGE_PATH=./storage
